---
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import HeroContact from '@components/sections/HeroContact.astro';
import ConditionGroupPage from '@components/sections/ConditionGroupPage.astro';
import InTheNews from '@components/sections/InTheNews.astro';
import { pressForCondition } from '@data/press';
import Reveal from '@components/react/Reveal';
import ScrollTimeline from '@components/react/ScrollTimeline';
import Services from '@components/sections/Services.astro';
import ServicesGrid from '@components/sections/ServicesGrid.astro';
import { conditionGroups, images, site } from '@data/site';
import { getConditionContent } from '@data/conditions';

export function getStaticPaths() {
  const conditionPages = conditionGroups.flatMap((g) =>
    g.items.map((c) => ({ params: { slug: c.slug }, props: { condition: c, group: g.title } })),
  );
  // One overview page per group (e.g. /conditions/cervical-spine) listing its conditions.
  const groupPages = conditionGroups.map((g) => ({ params: { slug: g.slug }, props: { groupPage: g } }));
  return [...conditionPages, ...groupPages];
}

const { condition, group, groupPage } = Astro.props;
const c = condition ? getConditionContent(condition.slug) : undefined;
const news = condition ? pressForCondition(condition.slug) : [];
const L = {
  causes: 'Causes',
  symptoms: 'Symptoms',
  symptomList: 'Common symptoms',
  diagnosis: 'Diagnosis',
  treatment: 'Treatment',
  nonSurgical: 'First: without surgery',
  nonSurgicalTitle: 'Where almost everyone starts',
  surgical: 'When needed: surgery',
  surgicalTitle: 'The least invasive option that will work',
  livingWell: 'Everyday care',
  ...(c?.labels ?? {}),
};
const heroImage = c?.photos[0] ?? images.handshakeScreen;
---

{groupPage ? (
  <ConditionGroupPage group={groupPage} />
) : (
<PageLayout
  title={condition.title}
  eyebrow={group}
  lede={c?.intro}
  image={heroImage}
  imageAlt=""
  position={c ? 'center 30%' : '70% 30%'}
>
  <HeroContact slot="hero" />
  {c ? (
    <>
      <!-- 1. Overview: text + photo -->
      <section class="section-y">
        <Container class="grid items-center gap-12 lg:grid-cols-12 lg:gap-20">
          <Reveal client:visible className="lg:col-span-6">
            <p class="eyebrow gold-rule text-gold">Overview</p>
            <h2 class="display mt-5 text-display-md text-ink">{c.overview.title}</h2>
            {c.overview.text.map((t) => <p class="mt-6 text-lg leading-relaxed">{t}</p>)}
            <div class="mt-10 flex flex-wrap gap-3">
              <Button href="/contact">Book a consultation</Button>
              <Button href={site.phoneHref} variant="outline">{site.phone}</Button>
            </div>
          </Reveal>
          <Reveal client:visible delay={0.1} className="lg:col-span-6">
            <div class="img-zoom aspect-[4/3] overflow-hidden rounded-sm bg-ink">
              <img src={c.photos[1]} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </div>
          </Reveal>
        </Container>
      </section>

      <!-- 2. Causes: dark, six cards -->
      <section data-dark class="section-y bg-ink text-white">
        <Container>
          <div class="max-w-3xl">
            <p class="eyebrow gold-rule text-gold-light">{L.causes}</p>
            <h2 class="display mt-5 text-display-md">{c.causes.title}</h2>
            <p class="mt-6 text-lg leading-relaxed text-white/75">{c.causes.text}</p>
          </div>
          <ul class="mt-14 grid gap-px overflow-hidden rounded-sm border border-line-dark bg-line-dark sm:grid-cols-2 lg:grid-cols-3">
            {c.causes.items.map((item, i) => (
              <Reveal client:visible as="li" delay={(i % 3) * 0.06} className="spot card-line group bg-ink p-8 transition-colors duration-500 hover:bg-ink-soft">
                <span class="flex h-11 w-11 items-center justify-center rounded-full border border-white/15 text-gold-light transition-all duration-500 group-hover:border-gold-light group-hover:bg-gold-light/10 group-hover:scale-110">
                  <Icon name="spine" class="h-5 w-5" />
                </span>
                <h3 class="display mt-7 text-[1.5rem] leading-snug text-white">{item.title}</h3>
                <p class="mt-3 text-[0.95rem] leading-relaxed text-white/65">{item.text}</p>
              </Reveal>
            ))}
          </ul>
        </Container>
      </section>

      <!-- 3. Symptoms + warning signs -->
      <section class="section-y">
        <Container class="grid gap-12 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <p class="eyebrow gold-rule text-gold">{L.symptoms}</p>
            <h2 class="display mt-5 text-display-md text-ink">{c.symptoms.title}</h2>
            <p class="mt-6 text-lg leading-relaxed">{c.symptoms.text}</p>
          </div>
          <div class="grid gap-10 lg:col-span-7 sm:grid-cols-2">
            <Reveal client:visible>
              <p class="eyebrow text-gold">{L.symptomList}</p>
              <ul class="mt-4 divide-y divide-line border-y border-line">
                {c.symptoms.items.map((x) => (
                  <li class="flex items-start gap-3 py-3 text-[0.98rem]">
                    <span aria-hidden="true" class="mt-3 h-px w-4 shrink-0 bg-gold"></span>
                    {x}
                  </li>
                ))}
              </ul>
            </Reveal>
            <Reveal client:visible delay={0.08}>
              <div class="h-full border border-line bg-bone/60 p-7">
                <p class="eyebrow text-gold">See a doctor right away if</p>
                <ul class="mt-4 space-y-3">
                  {c.symptoms.redFlags.map((x) => (
                    <li class="flex items-start gap-3 text-[0.98rem]">
                      <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold"></span>
                      {x}
                    </li>
                  ))}
                </ul>
                <p class="mt-6 text-sm text-slate">These can be signs of a problem that needs urgent care. Call {site.phone} or go to the nearest emergency room.</p>
              </div>
            </Reveal>
          </div>
        </Container>
      </section>

      <!-- 4. Diagnosis timeline -->
      <section class="section-y bg-bone/60">
        <Container class="grid gap-12 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <p class="eyebrow gold-rule text-gold">{L.diagnosis}</p>
            <h2 class="display mt-5 text-display-md text-ink">{c.diagnosis.title}</h2>
            <p class="mt-6 text-lg leading-relaxed">{c.diagnosis.text}</p>
          </div>
          <div class="lg:col-span-7">
            <ScrollTimeline client:visible items={c.diagnosis.steps} />
          </div>
        </Container>
      </section>

      <!-- 5. Treatment: dark, two columns -->
      <section data-dark class="section-y bg-ink text-white">
        <Container>
          <div class="max-w-3xl">
            <p class="eyebrow gold-rule text-gold-light">{L.treatment}</p>
            <h2 class="display mt-5 text-display-md">{c.treatment.title}</h2>
            <p class="mt-6 text-lg leading-relaxed text-white/75">{c.treatment.text}</p>
          </div>
          <div class="mt-14 grid gap-px overflow-hidden rounded-sm border border-line-dark bg-line-dark md:grid-cols-2">
            <Reveal client:visible className="spot card-line bg-ink p-8 md:p-10">
              <p class="eyebrow text-gold-light">{L.nonSurgical}</p>
              <p class="display mt-3 text-[1.5rem] leading-snug">{L.nonSurgicalTitle}</p>
              <ul class="mt-6 divide-y divide-line-dark border-y border-line-dark">
                {c.treatment.nonSurgical.map((x) => (
                  <li class="flex items-start gap-3 py-3 text-[0.98rem] text-white/85">
                    <span aria-hidden="true" class="mt-3 h-px w-4 shrink-0 bg-gold"></span>
                    {x}
                  </li>
                ))}
              </ul>
            </Reveal>
            <Reveal client:visible delay={0.08} className="spot card-line bg-ink p-8 md:p-10">
              <p class="eyebrow text-gold-light">{L.surgical}</p>
              <p class="display mt-3 text-[1.5rem] leading-snug">{L.surgicalTitle}</p>
              <ul class="mt-6 divide-y divide-line-dark border-y border-line-dark">
                {c.treatment.surgical.map((x) => (
                  <li class="flex items-start gap-3 py-3 text-[0.98rem] text-white/85">
                    <span aria-hidden="true" class="mt-3 h-px w-4 shrink-0 bg-gold"></span>
                    {x}
                  </li>
                ))}
              </ul>
            </Reveal>
          </div>
        </Container>
      </section>

      <!-- 6. Living well: photo + tips -->
      <section class="section-y">
        <Container class="grid items-center gap-12 lg:grid-cols-12 lg:gap-20">
          <Reveal client:visible className="lg:col-span-5">
            <div class="img-zoom aspect-[4/5] overflow-hidden rounded-sm bg-ink">
              <img src={c.photos[2]} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </div>
          </Reveal>
          <Reveal client:visible delay={0.1} className="lg:col-span-7">
            <p class="eyebrow gold-rule text-gold">{L.livingWell}</p>
            <h2 class="display mt-5 text-display-md text-ink">{c.livingWell.title}</h2>
            <p class="mt-6 text-lg leading-relaxed">{c.livingWell.text}</p>
            <ol class="mt-8 space-y-4">
              {c.livingWell.tips.map((tip, i) => (
                <li class="flex items-start gap-5">
                  <span class="display mt-0.5 w-8 shrink-0 text-2xl leading-none text-gold">{String(i + 1).padStart(2, '0')}</span>
                  <span class="leading-relaxed">{tip}</span>
                </li>
              ))}
            </ol>
          </Reveal>
        </Container>
      </section>

      <!-- 7. FAQ -->
      <section class="section-y bg-bone/60">
        <Container class="grid gap-12 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <p class="eyebrow gold-rule text-gold">Questions</p>
            <h2 class="display mt-5 text-display-md text-ink">Things patients ask about {condition.title.toLowerCase()}.</h2>
            <p class="mt-6 text-lg leading-relaxed">If your question is not here, call the office. We are happy to talk it through.</p>
            <div class="mt-8"><Button href="/contact">Book a consultation</Button></div>
          </div>
          <div class="lg:col-span-7">
            <div class="divide-y divide-line border-y border-line">
              {c.faqs.map((f) => (
                <details class="faq group" open>
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left">
                    <span class="display text-[1.35rem] leading-snug text-ink transition-colors group-open:text-gold">{f.q}</span>
                    <span
                      aria-hidden="true"
                      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-gold transition-transform duration-300 group-open:rotate-45"
                    >
                      <svg width="14" height="14" viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.4" /></svg>
                    </span>
                  </summary>
                  <p class="pb-6 pr-12 leading-relaxed">{f.a}</p>
                </details>
              ))}
            </div>
          </div>
        </Container>
      </section>

      <!-- 8. In the news (only when there is coverage) -->
      <InTheNews items={news} dark />

      <!-- 9. Related services -->
      <ServicesGrid eyebrow="Related services" title="How we treat it." lede="" only={c.relatedServices} />
    </>
  ) : (
    <>
      <section class="section-y">
        <Container class="max-w-3xl">
          <p class="text-lg leading-relaxed">Detailed content for {condition.title} is coming soon.</p>
          <div class="mt-10"><Button href="/contact">Book a consultation</Button></div>
        </Container>
      </section>
      <Services />
    </>
  )}
</PageLayout>
)}

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
