---
import PageLayout from '@layouts/PageLayout.astro';
import About from '@components/sections/About.astro';
import Credentials from '@components/sections/Credentials.astro';
import LegacyBand from '@components/sections/LegacyBand.astro';
import WhyChoose from '@components/sections/WhyChoose.astro';
import PressSection from '@components/sections/PressSection.astro';
import TestimonialsSection from '@components/sections/TestimonialsSection.astro';
import { site, images } from '@data/site';
---

<PageLayout title="About Dr. Bhalla" eyebrow="About" lede={site.description} description="Meet Dr. Amandeep Bhalla, a board-certified, fellowship-trained orthopedic spine surgeon in Long Beach. His training, awards, hospital leadership and approach to care." image={images.headshotWide} imageAlt="Dr. Amandeep Bhalla">
  <About />
  <LegacyBand />
  <Credentials />
  <PressSection />
  <WhyChoose />
  <TestimonialsSection />
</PageLayout>
