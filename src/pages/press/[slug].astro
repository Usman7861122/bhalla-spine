---
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import Reveal from '@components/react/Reveal';
import HeroContact from '@components/sections/HeroContact.astro';
import ServicesGrid from '@components/sections/ServicesGrid.astro';
import { press, formatPressDate } from '@data/press';
import { conditions, services, images } from '@data/site';
import { getConditionContent } from '@data/conditions';

export function getStaticPaths() {
  return press.map((p) => ({ params: { slug: p.slug }, props: { feature: p } }));
}

const { feature } = Astro.props;
const f = feature;
const relatedConditions = f.conditions
  .map((slug) => conditions.find((c) => c.slug === slug))
  .filter((c): c is (typeof conditions)[number] => Boolean(c))
  .map((c) => ({ ...c, image: getConditionContent(c.slug)?.photos[0] ?? images.spineModel }));
const relatedServices = f.services.filter((slug) => services.some((s) => s.slug === slug));
const others = press.filter((p) => p.slug !== f.slug);
---

<PageLayout
  title={f.title}
  eyebrow={`In the news: ${f.outlet}`}
  lede={f.deck}
  description={f.deck}
  image={f.image}
  imageAlt=""
  position="center 30%"
>
  <!-- Byline + link to the original, at the top of the page -->
  <div slot="hero" class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
    <Button href={f.url} variant="light" external>
      Read the original on {f.outlet}
      <Icon name="arrow" class="ml-2 h-4 w-4" />
    </Button>
    <p class="text-[0.9rem] text-white/60">
      By {f.author} · <time datetime={f.date}>{formatPressDate(f.date)}</time>
    </p>
  </div>
  <HeroContact slot="hero" />

  <!-- Article -->
  <article class="section-y">
    <Container class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Sticky side: highlights + source -->
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <p class="eyebrow gold-rule text-gold">At a glance</p>
          <dl class="mt-6 divide-y divide-line border-y border-line">
            {f.highlights.map((h) => (
              <div class="flex items-baseline justify-between gap-6 py-4">
                <dt class="text-[0.9rem] text-slate">{h.label}</dt>
                <dd class="display text-2xl text-ink">{h.value}</dd>
              </div>
            ))}
          </dl>
          <div class="mt-8 border border-line bg-bone/60 p-6">
            <p class="eyebrow text-gold">Source</p>
            <p class="mt-3 leading-relaxed">
              This page summarizes an article published by <a href={f.outletUrl} target="_blank" rel="noopener" class="link-underline font-medium text-ink">{f.outlet}</a>. The full text and original photographs belong to the publisher.
            </p>
            <a href={f.url} target="_blank" rel="noopener" class="group mt-4 inline-flex items-center gap-2 text-sm font-medium text-ink">
              Open the article
              <Icon name="arrow" class="h-4 w-4 text-gold transition-transform duration-300 group-hover:translate-x-1" />
            </a>
          </div>
        </div>
      </aside>

      <!-- Body with photos between paragraphs -->
      <div class="lg:col-span-8">
        <Reveal client:visible>
          <p class="display text-[1.6rem] leading-snug text-ink md:text-[1.9rem]">{f.body[0]}</p>
        </Reveal>

        {f.images[1] && (
          <Reveal client:visible className="mt-10">
            <figure>
              <div class="img-zoom aspect-[3/2] overflow-hidden rounded-sm bg-bone">
                <img src={f.images[1].src} alt={f.images[1].caption} loading="lazy" decoding="async" class="h-full w-full object-cover" />
              </div>
              <figcaption class="mt-3 text-[0.85rem] leading-relaxed text-slate">
                {f.images[1].caption} <span class="text-mist">{f.images[1].credit}</span>
              </figcaption>
            </figure>
          </Reveal>
        )}

        {f.body.slice(1, 3).map((p) => (
          <p class="mt-8 text-lg leading-relaxed">{p}</p>
        ))}

        {f.quotes[0] && (
          <Reveal client:visible className="my-12 border-l-2 border-gold pl-8">
            <blockquote>
              <p class="display text-[1.8rem] leading-snug text-ink md:text-[2.2rem]">"{f.quotes[0].text}"</p>
              <footer class="mt-4 text-[0.9rem] text-slate">{f.quotes[0].by}</footer>
            </blockquote>
          </Reveal>
        )}

        {f.images[2] && (
          <Reveal client:visible className="mt-4">
            <figure>
              <div class="img-zoom aspect-[3/2] overflow-hidden rounded-sm bg-bone">
                <img src={f.images[2].src} alt={f.images[2].caption} loading="lazy" decoding="async" class="h-full w-full object-cover" />
              </div>
              <figcaption class="mt-3 text-[0.85rem] leading-relaxed text-slate">
                {f.images[2].caption} <span class="text-mist">{f.images[2].credit}</span>
              </figcaption>
            </figure>
          </Reveal>
        )}

        {f.body.slice(3).map((p) => (
          <p class="mt-8 text-lg leading-relaxed">{p}</p>
        ))}

        <div class="mt-10 flex flex-wrap gap-3">
          <Button href={f.url} variant="outline" external>Read the full article</Button>
          <Button href="/contact">Book a consultation</Button>
        </div>
      </div>
    </Container>
  </article>

  <!-- Related conditions: dark photo cells -->
  {relatedConditions.length > 0 && (
    <section data-dark class="section-y bg-ink text-white">
      <Container>
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div class="max-w-2xl">
            <p class="eyebrow gold-rule text-gold-light">Conditions we treat</p>
            <h2 class="display mt-5 text-display-md">Conditions related to this story.</h2>
          </div>
          <Button href="/conditions" variant="outline-light" class="shrink-0">All conditions</Button>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
          {relatedConditions.map((c, i) => (
            <Reveal client:visible as="li" delay={i * 0.06}>
              <a href={`/conditions/${c.slug}`} class="group relative isolate flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-sm bg-ink-soft p-6 text-white">
                <img src={c.image} alt="" loading="lazy" decoding="async" class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-out-soft)] group-hover:scale-[1.05]" />
                <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(15,31,46,0.15)_0%,rgba(15,31,46,0.5)_50%,rgba(15,31,46,0.95)_100%)]"></div>
                <span class="eyebrow text-gold-light">{c.kind}</span>
                <h3 class="display mt-2 text-[1.5rem] leading-tight">{c.title}</h3>
                <span class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-gold-light">
                  Learn more
                  <Icon name="arrow" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
                </span>
              </a>
            </Reveal>
          ))}
        </ul>
      </Container>
    </section>
  )}

  <!-- Related services -->
  {relatedServices.length > 0 && (
    <ServicesGrid eyebrow="Care services" title="Services mentioned in this story." lede="" only={relatedServices} />
  )}

  <!-- More coverage -->
  {others.length > 0 && (
    <section class="section-y">
      <Container>
        <p class="eyebrow gold-rule text-gold">More coverage</p>
        <h2 class="display mt-5 text-display-md text-ink">Dr. Bhalla in the news.</h2>
        <ul class="mt-12 grid gap-px overflow-hidden rounded-sm border border-line bg-line md:grid-cols-3">
          {others.map((p) => (
            <li>
              <a href={`/press/${p.slug}`} class="card-line group flex h-full flex-col bg-porcelain p-7 transition-colors hover:bg-white">
                <p class="eyebrow text-gold">{p.outlet}</p>
                <h3 class="display mt-3 text-[1.4rem] leading-snug text-ink transition-colors group-hover:text-gold">{p.title}</h3>
                <p class="mt-auto pt-6 text-[0.8rem] text-mist">{formatPressDate(p.date)}</p>
              </a>
            </li>
          ))}
        </ul>
      </Container>
    </section>
  )}
</PageLayout>
