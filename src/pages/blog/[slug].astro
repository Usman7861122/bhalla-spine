---
import ArticleBody from '@components/sections/ArticleBody.astro';
import { posts } from '@data/site';

export function getStaticPaths() {
  return posts.filter((p) => p.href.startsWith('/blog/')).map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
---

<ArticleBody {...post} />
