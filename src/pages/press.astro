---
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/ui/Container.astro';
import Icon from '@components/ui/Icon.astro';
import Reveal from '@components/react/Reveal';
import HeroContact from '@components/sections/HeroContact.astro';
import WhyChoose from '@components/sections/WhyChoose.astro';
import { press, formatPressDate } from '@data/press';
import { images, site } from '@data/site';
import VideoModal from '@components/ui/VideoModal.astro';

// Features appear in the order they were added to press.ts.
const sorted = press;
---

<PageLayout
  title="In the news"
  eyebrow="Press"
  lede="Articles and features about Dr. Bhalla and his work, published by outside outlets. Each page summarizes the story and links to the original."
  description="Press coverage of Dr. Amandeep Bhalla, orthopedic spine surgeon in Long Beach, CA."
  image={sorted[0]?.image ?? images.handshakeScreen}
  imageAlt=""
  position="center 30%"
>
  <div slot="hero" class="mt-8">
    <VideoModal facebookUrl={site.video.facebookUrl} title={site.video.title} label="Watch the video" variant="light" />
  </div>
  <HeroContact slot="hero" />

  <section class="section-y">
    <Container>
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {sorted.map((p, i) => (
          <Reveal client:visible as="li" delay={(i % 3) * 0.08}>
            <a href={`/press/${p.slug}`} class="card-line group flex h-full flex-col overflow-hidden rounded-sm border border-line bg-porcelain transition-colors hover:bg-white">
              <div class="img-zoom aspect-[16/10] overflow-hidden bg-ink-soft">
                <img src={p.image} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
              </div>
              <div class="flex flex-1 flex-col p-7">
                <p class="eyebrow text-gold">{p.outlet}</p>
                <h2 class="display mt-3 text-[1.5rem] leading-snug text-ink transition-colors group-hover:text-gold">{p.title}</h2>
                <p class="mt-3 text-[0.95rem] leading-relaxed text-slate">{p.deck}</p>
                <div class="mt-auto flex items-center justify-between pt-6 text-[0.8rem] text-mist">
                  <time datetime={p.date}>{formatPressDate(p.date)}</time>
                  <Icon name="arrow" class="h-4 w-4 text-gold transition-transform duration-300 group-hover:translate-x-1" />
                </div>
              </div>
            </a>
          </Reveal>
        ))}
      </ul>
    </Container>
  </section>

  <WhyChoose />
</PageLayout>
