---
import '@styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@components/react/Header';
import Footer from '@components/Footer.astro';
import CookieConsent from '@components/ui/CookieConsent.astro';
import MobileActionBar from '@components/ui/MobileActionBar.astro';
import { site } from '@data/site';

interface Props {
  title?: string;
  description?: string;
  /** Transparent header over a dark hero (inner pages). */
  transparentHeader?: boolean;
  /** Transparent header with dark text over a light hero (home page). */
  lightHero?: boolean;
  /** Keep this page out of search results (used by the 404 page). */
  noindex?: boolean;
  /** Social share image (path or full URL). Falls back to the main photo. */
  image?: string;
  type?: 'website' | 'article';
  /** ISO date, for articles. */
  published?: string;
}

const { title, description = site.description, transparentHeader = false, lightHero = false, noindex = false, image, type = 'website', published } = Astro.props;
const headerMode = lightHero ? 'light' : transparentHeader ? 'transparent' : 'solid';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const origin = 'https://bhallaspine.com';
const address = {
  '@type': 'PostalAddress',
  streetAddress: '3610 Long Beach Blvd, Suite 202',
  addressLocality: 'Long Beach',
  addressRegion: 'CA',
  postalCode: '90807',
  addressCountry: 'US',
};
const openingHoursSpecification = {
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
  opens: '08:00',
  closes: '17:00',
};
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['MedicalClinic', 'LocalBusiness'],
      '@id': `${origin}/#clinic`,
      name: 'Amandeep Bhalla, MD | Orthopedic Spine Surgeon',
      url: origin,
      telephone: '+1-562-427-8119',
      email: site.email,
      image: `${origin}/images/C1A3704-scaled-e1747239020857.jpg`,
      medicalSpecialty: 'Orthopedic',
      address,
      areaServed: { '@type': 'City', name: 'Long Beach' },
      openingHoursSpecification,
      parentOrganization: { '@type': 'Organization', name: 'Commons Clinic', url: 'https://commonsclinic.com/' },
      sameAs: [site.social.linkedin],
      employee: { '@id': `${origin}/#physician` },
    },
    {
      '@type': 'Physician',
      '@id': `${origin}/#physician`,
      name: 'Dr. Amandeep Bhalla',
      url: origin,
      telephone: '+1-562-427-8119',
      medicalSpecialty: 'Orthopedic',
      description: site.description,
      image: `${origin}/images/C1A3704-scaled-e1747239020857.jpg`,
      address,
      openingHoursSpecification,
      sameAs: [site.social.linkedin],
      worksFor: { '@id': `${origin}/#clinic` },
    },
  ],
};
/* Keep the title under about 60 characters: drop the brand suffix when the page title is already long. */
const withBrand = title ? `${title} | ${site.name}` : '';
const pageTitle = !title ? `${site.name} | Orthopedic Spine Surgeon, Long Beach` : withBrand.length <= 62 ? withBrand : title;
const ogImage = new URL(image || '/images/bhalla-main.jpg', origin).href;

/* Breadcrumbs from the address: Home > section > page. */
const sections: Record<string, string> = { services: 'Services', conditions: 'Conditions', press: 'In the news', blog: 'Blog' };
const parts = Astro.url.pathname.split('/').filter(Boolean);
const crumbs: { name: string; url: string }[] = [{ name: 'Home', url: `${origin}/` }];
if (!noindex && Astro.url.pathname !== '/') {
  if (type === 'article' && parts[0] !== 'blog') crumbs.push({ name: 'Blog', url: `${origin}/blog/` });
  else if (parts.length > 1 && sections[parts[0]]) crumbs.push({ name: sections[parts[0]], url: `${origin}/${parts[0]}/` });
  crumbs.push({ name: title ?? parts[parts.length - 1], url: canonical });
}
const extra: Record<string, unknown>[] = [];
if (crumbs.length > 1) {
  extra.push({
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })),
  });
}
if (type === 'article' && title) {
  extra.push({
    '@type': 'BlogPosting',
    headline: title,
    description,
    image: ogImage,
    datePublished: published,
    dateModified: published,
    mainEntityOfPage: canonical,
    author: { '@id': `${origin}/#physician` },
    publisher: { '@id': `${origin}/#clinic` },
  });
}
(schema['@graph'] as unknown[]).push(...extra);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <ClientRouter />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col pb-[3.6rem] md:pb-0" data-header={headerMode}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-white"
    >
      Skip to content
    </a>
    <Header client:load mode={headerMode} transition:persist transition:name="header" />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
    <CookieConsent />
    <script>
      import '@lib/spotlight';
    </script>
  </body>
</html>
