---
/**
 * Small cookie notice, bottom left. Slides up after a short delay on the first visit,
 * remembers the choice in localStorage and never shows again.
 *
 * The choice is stored as "accepted" or "declined" under `bs-cookie-consent` and announced
 * as a `cookie-consent` event on `window`, so analytics or embeds can wait for it.
 */
---

<div id="cookie-consent" class="cookie" role="dialog" aria-live="polite" aria-label="Cookie notice" hidden>
  <div class="cookie-card">
    <span class="cookie-mark" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 3a9 9 0 1 0 9 9c0-.5 0-1-.1-1.4a3 3 0 0 1-3.4-3.3A3 3 0 0 1 14.6 3.2 9 9 0 0 0 12 3z" />
        <circle cx="8.5" cy="10" r="1" fill="currentColor" stroke="none" />
        <circle cx="10" cy="15.5" r="1" fill="currentColor" stroke="none" />
        <circle cx="15" cy="14" r="1" fill="currentColor" stroke="none" />
      </svg>
    </span>
    <p class="cookie-text">
      We use a few cookies to understand how the site is used and to play embedded video.
      <a href="/privacy" class="link-underline">Privacy policy</a>
    </p>
    <div class="cookie-actions">
      <button type="button" class="cookie-btn cookie-decline" data-consent="declined">Decline</button>
      <button type="button" class="cookie-btn cookie-accept" data-consent="accepted">Accept</button>
    </div>
  </div>
</div>

<style>
  .cookie {
    position: fixed;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: flex;
    justify-content: flex-start;
    pointer-events: none;
  }
  .cookie[hidden] {
    display: none;
  }
  .cookie-card {
    pointer-events: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.1rem;
    max-width: 40rem;
    padding: 0.9rem 1rem 0.9rem 1.1rem;
    border-radius: 0.25rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(15, 31, 46, 0.92);
    color: white;
    backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 30px 60px -30px rgba(15, 31, 46, 0.6);
    transform: translateY(1.5rem);
    opacity: 0;
    transition:
      transform 0.6s var(--ease-out-soft),
      opacity 0.6s var(--ease-out-soft);
  }
  .cookie.is-in .cookie-card {
    transform: none;
    opacity: 1;
  }
  .cookie.is-out .cookie-card {
    transform: translateY(1rem);
    opacity: 0;
    transition-duration: 0.35s;
  }
  .cookie-mark {
    display: none;
    height: 2.25rem;
    width: 2.25rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(216, 194, 148, 0.4);
    color: var(--color-gold-light);
  }
  .cookie-text {
    flex: 1 1 16rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
  }
  .cookie-text a {
    margin-left: 0.35rem;
    color: white;
    white-space: nowrap;
  }
  .cookie-actions {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }
  .cookie-btn {
    height: 2.5rem;
    padding: 0 1.1rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition:
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s,
      transform 0.3s var(--ease-out-soft);
  }
  .cookie-btn:hover {
    transform: translateY(-1px);
  }
  .cookie-decline {
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.8);
  }
  .cookie-decline:hover {
    border-color: white;
    color: white;
  }
  .cookie-accept {
    background: white;
    color: var(--color-ink);
  }
  .cookie-accept:hover {
    background: var(--color-gold-light);
  }
  @media (max-width: 767px) {
    .cookie {
      left: 0.75rem;
      right: 0.75rem;
      bottom: calc(4.4rem + env(safe-area-inset-bottom));
    }
    .cookie-card {
      padding: 0.75rem 0.85rem;
      gap: 0.6rem 0.8rem;
    }
    .cookie-text {
      font-size: 0.78rem;
      line-height: 1.4;
    }
    .cookie-actions {
      width: 100%;
    }
    .cookie-btn {
      flex: 1;
      height: 2.2rem;
    }
  }
  @media (min-width: 640px) {
    .cookie-mark {
      display: flex;
    }
    .cookie-card {
      flex-wrap: nowrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cookie-card {
      transition: none;
    }
  }
</style>

<script>
  const KEY = 'bs-cookie-consent';

  function initCookieConsent() {
    const el = document.getElementById('cookie-consent');
    if (!el || el.dataset.ready) return;
    el.dataset.ready = '1';

    let stored: string | null = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch {}
    if (stored) {
      window.dispatchEvent(new CustomEvent('cookie-consent', { detail: stored }));
      return;
    }

    // Show after a short pause so it does not compete with the hero.
    el.hidden = false;
    window.setTimeout(() => el.classList.add('is-in'), 1400);

    el.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const choice = btn.dataset.consent ?? 'declined';
        try {
          localStorage.setItem(KEY, choice);
        } catch {}
        window.dispatchEvent(new CustomEvent('cookie-consent', { detail: choice }));
        el.classList.remove('is-in');
        el.classList.add('is-out');
        window.setTimeout(() => (el.hidden = true), 400);
      });
    });
  }

  initCookieConsent();
  document.addEventListener('astro:page-load', initCookieConsent);
</script>
