---
/**
 * A button that opens a video in a full screen pop up. The player only loads when opened
 * and is removed when closed, so nothing plays in the background and nothing from
 * Facebook loads until the visitor asks for it.
 *
 * Usage:
 *   <VideoModal facebookUrl="https://www.facebook.com/watch/?v=123" label="Watch the video" />
 *   <VideoModal src="/videos/clip.mp4" label="Watch" variant="outline" />
 */
import Button from '@components/ui/Button.astro';

interface Props {
  facebookUrl?: string;
  src?: string;
  label?: string;
  title?: string;
  variant?: 'dark' | 'light' | 'outline' | 'outline-light' | 'gold';
  class?: string;
}
const { facebookUrl, src, label = 'Watch the video', title = 'Video', variant = 'outline', class: className = '' } = Astro.props;

const embedSrc = facebookUrl
  ? `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(facebookUrl)}&show_text=false&autoplay=true&mute=false&width=1280`
  : undefined;
const id = `video-${Math.random().toString(36).slice(2, 8)}`;
---

<Button variant={variant} class={`video-open ${className}`} data-dialog={id}>
  <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" class="-ml-1"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
  {label}
</Button>

<dialog id={id} class="video-dialog" data-embed={embedSrc} data-src={src} aria-label={title}>
  <div class="video-dialog-inner">
    <button type="button" class="video-close" aria-label="Close video">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
    <div class="video-dialog-frame"></div>
    <p class="video-dialog-title">{title}</p>
  </div>
</dialog>

<style>
  .video-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: white;
    display: grid;
    place-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease-out-soft);
  }
  .video-dialog[open] {
    opacity: 1;
    pointer-events: auto;
  }
  .video-dialog::backdrop {
    background: rgba(15, 31, 46, 0.92);
    backdrop-filter: blur(6px);
  }
  .video-dialog-inner {
    position: relative;
    width: min(92vw, 72rem);
    transform: translateY(14px) scale(0.98);
    transition: transform 0.45s var(--ease-out-soft);
  }
  .video-dialog[open] .video-dialog-inner {
    transform: none;
  }
  .video-dialog-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 0.125rem;
    overflow: hidden;
    box-shadow: 0 40px 100px -40px rgba(0, 0, 0, 0.8);
  }
  .video-dialog-frame :global(iframe),
  .video-dialog-frame :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }
  .video-dialog-title {
    margin-top: 1rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }
  .video-close {
    position: absolute;
    right: 0;
    top: -3.25rem;
    display: flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    transition: border-color 0.3s, background-color 0.3s, transform 0.3s;
  }
  .video-close:hover {
    border-color: var(--color-gold-light);
    background: rgba(216, 194, 148, 0.15);
    transform: rotate(90deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .video-dialog,
    .video-dialog-inner,
    .video-close {
      transition: none;
    }
  }
</style>

<script>
  function initVideoModals() {
    document.querySelectorAll<HTMLElement>('.video-open').forEach((btn) => {
      if (btn.dataset.ready) return;
      btn.dataset.ready = '1';
      const dialog = document.getElementById(btn.dataset.dialog ?? '') as HTMLDialogElement | null;
      if (!dialog) return;
      const frame = dialog.querySelector<HTMLElement>('.video-dialog-frame');
      const close = dialog.querySelector<HTMLButtonElement>('.video-close');

      const mount = () => {
        if (!frame) return;
        const embed = dialog.dataset.embed;
        const src = dialog.dataset.src;
        if (src) {
          const v = document.createElement('video');
          v.src = src;
          v.controls = true;
          v.autoplay = true;
          v.playsInline = true;
          frame.replaceChildren(v);
        } else if (embed) {
          const f = document.createElement('iframe');
          f.src = embed;
          f.allow = 'autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share';
          f.allowFullscreen = true;
          f.title = dialog.getAttribute('aria-label') ?? 'Video';
          frame.replaceChildren(f);
        }
      };
      const unmount = () => frame?.replaceChildren();

      const open = () => {
        mount();
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      };
      const shut = () => {
        dialog.close();
      };

      btn.addEventListener('click', open);
      close?.addEventListener('click', shut);
      // Click on the dark backdrop closes it.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) shut();
      });
      dialog.addEventListener('close', () => {
        unmount();
        document.documentElement.style.overflow = '';
      });
    });
  }
  initVideoModals();
  document.addEventListener('astro:page-load', initVideoModals);
</script>
