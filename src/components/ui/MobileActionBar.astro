---
/** Two sticky buttons at the bottom of phone screens: call and book. Hidden from the md breakpoint up. */
import Icon from '@components/ui/Icon.astro';
import { site } from '@data/site';
---

<nav class="mbar" aria-label="Quick actions">
  <a href={site.phoneHref} class="mbar-btn mbar-call">
    <Icon name="phone" class="h-[1.05rem] w-[1.05rem]" />
    {site.phone}
  </a>
  <a href="/contact" class="mbar-btn mbar-book">
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.6" /></svg>
    Appointment
  </a>
</nav>

<style>
  .mbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 55;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 1.75rem 1.75rem 0 0;
    overflow: hidden;
    box-shadow: 0 -14px 40px -12px rgba(15, 31, 46, 0.35);
  }
  .mbar-btn {
    display: flex;
    height: calc(3.6rem + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    color: white;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: linear-gradient(180deg, #2a4258 0%, var(--color-ink) 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
    transition: filter 0.3s;
  }
  .mbar-btn:active {
    filter: brightness(1.25);
  }
  .mbar-book {
    border-left: 1px solid rgba(255, 255, 255, 0.28);
  }
  .mbar-btn :global(svg) {
    color: var(--color-gold-light);
  }
  @media (min-width: 768px) {
    .mbar {
      display: none;
    }
  }
</style>
