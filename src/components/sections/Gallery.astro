---
import SectionHeading from '@components/ui/SectionHeading.astro';
import ExpandableGallery from '@components/react/ExpandableGallery';
import { images } from '@data/site';
---

<section id="gallery" class="section-y bg-bone/60">
  <div class="container-x">
    <SectionHeading
      eyebrow="Our gallery"
      title="A calm place to be seen."
      lede="Our clinic at Commons Clinic in Long Beach, where consultations, imaging review and follow-ups happen."
      align="center"
    />
    <div class="mt-16">
      <ExpandableGallery client:visible images={images.gallery} />
    </div>
  </div>
</section>
