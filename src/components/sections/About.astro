---
import Reveal from '@components/react/Reveal';
import Button from '@components/ui/Button.astro';
import { site, images, appointments } from '@data/site';
---

<section id="about" class="section-y">
  <div class="container-x grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
    <!-- Photo -->
    <Reveal client:visible className="lg:col-span-5">
      <figure class="relative">
        <div class="img-zoom aspect-[4/5] overflow-hidden rounded-sm bg-bone">
          <img
            src={images.doctorPortrait}
            alt={`${site.doctor} in clinic`}
            loading="lazy"
            decoding="async"
            width="800"
            height="1000"
            class="h-full w-full object-cover object-top"
          />
        </div>
        <figcaption
          class="absolute -bottom-6 -right-4 max-w-[16rem] border border-line bg-porcelain p-5 shadow-[0_20px_50px_-30px_rgba(15,31,46,0.35)] md:-right-10"
        >
          <p class="eyebrow text-gold">Trained at</p>
          <p class="display mt-2 text-xl leading-snug text-ink">
            UCLA, Harvard and Massachusetts General Hospital.
          </p>
        </figcaption>
      </figure>
    </Reveal>

    <!-- Copy -->
    <Reveal client:visible delay={0.1} className="lg:col-span-7">
      <p class="eyebrow gold-rule text-gold">About the doctor</p>
      <h2 class="display mt-5 text-display-md text-ink md:text-[clamp(2.25rem,3.6vw,3.4rem)] md:whitespace-nowrap">
        {site.doctor}, <span class="text-slate">MD</span>
      </h2>
      <p class="mt-7 text-lg leading-relaxed">
        Dr. Bhalla is a board-certified, fellowship-trained orthopedic spine surgeon specializing in spinal and neck
        injuries. His expertise includes minimally invasive, motion-preserving and robotic-assisted spine surgery.
        He trained at UCLA, Harvard and Massachusetts General Hospital.
      </p>
      <p class="mt-5 leading-relaxed">
        He emphasizes evidence-based, patient-centered care with a focus on shared decision-making: understanding
        your goals first, then choosing the least invasive path that will get you back to them.
      </p>

      <ul class="mt-9 space-y-3 border-t border-line pt-7">
        {appointments.map((a) => (
          <li class="flex gap-4 text-[0.95rem] text-ink">
            <span aria-hidden="true" class="mt-2.5 h-px w-5 shrink-0 bg-gold"></span>
            {a}
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-wrap gap-3">
        <Button href="/about">Full biography</Button>
        <Button href="#credentials" variant="outline">Boards &amp; education</Button>
      </div>
    </Reveal>
  </div>
</section>
