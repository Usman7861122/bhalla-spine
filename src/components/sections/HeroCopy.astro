---
/** Text block for the home hero. `tone="light"` = white text over the dark tint (desktop). */
import Button from '@components/ui/Button.astro';
import { site, images } from '@data/site';

interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
const light = tone === 'light';
/* The hero text is rendered twice (desktop overlay and mobile card, one hidden by CSS). Only one real <h1> in the HTML. */
const Tag = light ? 'p' : 'h1';
const trained = ['UCLA', 'Harvard', 'Massachusetts General'];
---

<p class:list={['eyebrow gold-rule', light ? 'text-gold-light' : 'text-gold']}>{site.role}</p>
<Tag {...(light ? { role: 'heading', 'aria-level': 1 } : {})} class:list={['display mt-5 text-[clamp(2.6rem,4.3vw,4.1rem)] leading-[1.02]', light ? 'text-white' : 'text-ink']}>
  Conservative care <em class:list={['font-light italic', light ? 'text-gold-light' : 'text-gold']}>first.</em> Surgery only when needed.
</Tag>
<p class:list={['mt-6 max-w-md text-[1.05rem] leading-relaxed', light ? 'text-white/80' : 'text-slate']}>
  Most back and neck problems improve without an operation. When surgery is the answer, Dr. Bhalla uses the least invasive option that will work, in Long Beach.
</p>
<div class="mt-8 flex flex-wrap gap-3">
  <Button href={site.bookingUrl} external variant={light ? 'light' : 'dark'}>Book a consultation</Button>
  <Button href="/services/non-surgical-care" variant={light ? 'outline-light' : 'outline'}>Non-surgical care</Button>
</div>

<div class:list={['mt-9 flex flex-wrap items-center gap-x-6 gap-y-3 border-t pt-6', light ? 'border-white/20' : 'border-line']}>
  <span class:list={['eyebrow', light ? 'text-white/50' : 'text-mist']}>Trained at</span>
  {trained.map((t) => <span class:list={['display text-xl', light ? 'text-white' : 'text-ink']}>{t}</span>)}
</div>

<a
  href={site.affiliation.url}
  target="_blank"
  rel="noopener"
  class:list={['group mt-6 inline-flex items-center gap-4 transition-colors', light ? 'text-white/60 hover:text-white' : 'text-mist hover:text-ink']}
  aria-label={`Affiliated with ${site.affiliation.name} (opens in a new tab)`}
>
  <span class="eyebrow">Affiliated with</span>
  <img
    src={light ? images.commonsLogoWhite : images.commonsLogo}
    alt={site.affiliation.name}
    width="110"
    height="30"
    class="h-6 w-auto opacity-80 transition-opacity group-hover:opacity-100"
  />
</a>
