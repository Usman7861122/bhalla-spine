---
/**
 * Full-width "window" parallax: the photo stays fixed while the page scrolls over it.
 * Technique: a position:fixed image inside a section with clip-path:inset(0).
 * Works on iOS Safari (unlike background-attachment: fixed).
 */
import Button from '@components/ui/Button.astro';
import { images, site } from '@data/site';

interface Props {
  src: string;
  alt: string;
  eyebrow: string;
  title: string;
  text?: string;
  cta?: { label: string; href: string };
  stats?: { value: string; label: string }[];
  position?: string;
}

const { src, alt, eyebrow, title, text, cta, stats = [], position = 'center 40%' } = Astro.props;
---

<section id="legacy" data-dark class="band relative isolate min-h-[85vh] text-white">
  <!-- Fixed photo, clipped to the section -->
  <div class="band-bg" aria-hidden="true">
    <img src={src} alt="" loading="lazy" decoding="async" style={`object-position:${position}`} />
    <div class="band-veil"></div>
  </div>
  <span class="sr-only">{alt}</span>
  <!-- Faded Commons Clinic watermark -->
  <img
    src={images.commonsLogoWhite}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-6 top-16 w-[min(55vw,40rem)] opacity-[0.07] lg:right-16"
  />

  <div class="container-x relative flex min-h-[85vh] flex-col justify-end py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow gold-rule text-gold-light">{eyebrow}</p>
      <h2 class="display mt-5 text-display-lg">{title}</h2>
      {text && <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">{text}</p>}
      {cta && (
        <div class="mt-9">
          <Button href={cta.href} variant="light" size="lg">{cta.label}</Button>
        </div>
      )}
    </div>

    <a
      href={site.affiliation.url}
      target="_blank"
      rel="noopener"
      class="group mt-10 inline-flex items-center gap-4 text-white/60 transition-colors hover:text-white"
      aria-label={`Part of ${site.affiliation.name} (opens in a new tab)`}
    >
      <span class="eyebrow">Part of</span>
      <img src={images.commonsLogoWhite} alt={site.affiliation.name} width="110" height="30" class="h-6 w-auto opacity-80 transition-opacity group-hover:opacity-100" />
    </a>

    {stats.length > 0 && (
      <ul class="mt-14 grid gap-8 border-t border-white/20 pt-8 sm:grid-cols-3">
        {stats.map((s) => (
          <li class="pr-6">
            <p class="display text-4xl text-gold-light md:text-5xl">{s.value}</p>
            <p class="mt-2 text-[0.85rem] uppercase tracking-[0.18em] text-white/70">{s.label}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .band {
    /* Clips the fixed image to this section's box. */
    clip-path: inset(0);
    background: var(--color-ink);
  }
  .band-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .band-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .band-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 31, 46, 0.35) 0%,
      rgba(15, 31, 46, 0.45) 45%,
      rgba(15, 31, 46, 0.8) 100%
    );
  }
  @media (prefers-reduced-motion: reduce) {
    .band {
      clip-path: none;
      overflow: hidden;
    }
    .band-bg {
      position: absolute;
    }
  }
</style>
