---
/**
 * "In the news" block: press features that mention the current condition or service.
 * Renders nothing when there are none.
 */
import Container from '@components/ui/Container.astro';
import Icon from '@components/ui/Icon.astro';
import Reveal from '@components/react/Reveal';
import { formatPressDate, type PressFeature } from '@data/press';

interface Props {
  items: PressFeature[];
  /** Dark variant for pages where the previous section is light. */
  dark?: boolean;
}
const { items: all, dark = false } = Astro.props;
/* Show at most four; the News page has the rest. */
const items = all.slice(0, 4);
---

{all.length > 0 && (
  <section data-dark={dark ? '' : undefined} class:list={['section-y', dark ? 'bg-ink text-white' : 'bg-bone/60']}>
    <Container>
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class:list={['eyebrow gold-rule', dark ? 'text-gold-light' : 'text-gold']}>In the news</p>
          <h2 class:list={['display mt-5 text-display-md', dark ? 'text-white' : 'text-ink']}>Dr. Bhalla on this topic.</h2>
        </div>
        <a href="/press" class:list={['group inline-flex shrink-0 items-center gap-2 text-sm font-medium', dark ? 'text-white' : 'text-ink']}>
          All coverage
          <Icon name="arrow" class="h-4 w-4 text-gold transition-transform duration-300 group-hover:translate-x-1" />
        </a>
      </div>
      <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:gap-5">
        {items.map((p, i) => (
          <Reveal client:visible as="li" delay={i * 0.06}>
            <a
              href={`/press/${p.slug}`}
              class:list={[
                'group grid h-full overflow-hidden rounded-sm border transition-colors sm:grid-cols-[14rem_1fr]',
                dark ? 'border-line-dark bg-ink hover:bg-ink-soft' : 'border-line bg-porcelain hover:bg-white',
              ]}
            >
              <div class="img-zoom aspect-[4/3] overflow-hidden bg-ink-soft sm:aspect-auto sm:h-full">
                <img src={p.image} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
              </div>
              <div class="flex flex-col p-7">
                <p class:list={['eyebrow', dark ? 'text-gold-light' : 'text-gold']}>{p.outlet}</p>
                <h3 class:list={['display mt-3 text-[1.4rem] leading-snug transition-colors', dark ? 'text-white group-hover:text-gold-light' : 'text-ink group-hover:text-gold']}>
                  {p.title}
                </h3>
                <p class:list={['mt-3 text-[0.92rem] leading-relaxed', dark ? 'text-white/65' : 'text-slate']}>{p.deck}</p>
                <p class:list={['mt-auto pt-5 text-[0.8rem]', dark ? 'text-white/45' : 'text-mist']}>{formatPressDate(p.date)}</p>
              </div>
            </a>
          </Reveal>
        ))}
      </ul>
    </Container>
  </section>
)}
