---
/** Shared article layout for blog posts. `body` is trusted HTML from src/data. */
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import Blog from '@components/sections/Blog.astro';
import { site } from '@data/site';

interface Props {
  title: string;
  excerpt: string;
  category: string;
  image: string;
  date: string;
  readTime: string;
  body?: string;
}
const { title, excerpt, category, image, date, readTime, body } = Astro.props;
const when = new Date(date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<PageLayout title={title} eyebrow={category} lede={excerpt} description={excerpt} image={image} imageAlt={title}>
  <section class="section-y">
    <Container class="max-w-3xl">
      <p class="text-sm text-mist"><time datetime={date}>{when}</time> · {readTime}</p>
      {body ? <div class="article mt-8" set:html={body} /> : <p class="mt-8 text-lg leading-relaxed">Article content coming soon.</p>}
      <div class="mt-12 flex flex-wrap gap-3 border-t border-line pt-8">
        <Button href={site.bookingUrl} external>Book a consultation</Button>
        <Button href={site.phoneHref} variant="outline">{site.phone}</Button>
      </div>
    </Container>
  </section>
  <Blog limit={3} />
</PageLayout>

<style is:global>
  .article > * + * {
    margin-top: 1.25rem;
  }
  .article p,
  .article li {
    font-size: 1.125rem;
    line-height: 1.75;
  }
  .article h2 {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    line-height: 1.2;
    color: var(--color-ink);
  }
  .article h3 {
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-ink);
  }
  .article ul {
    list-style: none;
    padding: 0;
  }
  .article li {
    position: relative;
    padding-left: 1.75rem;
  }
  .article li + li {
    margin-top: 0.7rem;
  }
  .article li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 1rem;
    height: 1px;
    background: var(--color-gold);
  }
  .article strong {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
