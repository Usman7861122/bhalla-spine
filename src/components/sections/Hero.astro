---
import ParallaxImage from '@components/react/ParallaxImage';
import Button from '@components/ui/Button.astro';
import { site, images } from '@data/site';

const trained = ['UCLA', 'Harvard', 'Massachusetts General'];
---

<section id="hero" data-dark class="relative isolate min-h-[100svh] overflow-hidden bg-ink text-white">
  <!-- Parallax photo -->
  <ParallaxImage
    client:load
    src={images.hero}
    alt={`${site.doctor}, orthopedic spine surgeon`}
    position="center 30%"
    className="absolute inset-0 -z-20 h-[120%]"
  />
  <!-- Gradient veil so the headline stays readable over the photo -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(15,31,46,0.55)_0%,rgba(15,31,46,0.35)_35%,rgba(15,31,46,0.9)_70%,rgba(15,31,46,0.97)_100%)] md:bg-[linear-gradient(90deg,rgba(15,31,46,0.92)_0%,rgba(15,31,46,0.72)_38%,rgba(15,31,46,0.18)_70%,rgba(15,31,46,0.05)_100%)]"
  >
  </div>
  <div aria-hidden="true" class="absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-t from-ink to-transparent"></div>

  <div class="container-x relative flex min-h-[100svh] flex-col justify-end pb-16 pt-32 md:justify-center md:pb-24">
    <div class="max-w-2xl">
      <p class="eyebrow gold-rule text-gold-light hero-in" style="--i:0">{site.role}</p>
      <h1 class="display hero-in mt-6 text-display-xl" style="--i:1">
        Get back to<br />
        <em class="font-light italic text-gold-light">activities</em> you enjoy.
      </h1>
      <p class="hero-in mt-7 max-w-lg text-lg leading-relaxed text-white/75" style="--i:2">
        We combine the latest minimally invasive, motion-preserving and robotic-assisted techniques with
        evidence-based, compassionate care in Long Beach.
      </p>
      <div class="hero-in mt-10 flex flex-wrap gap-3" style="--i:3">
        <Button href="/contact" variant="light" size="lg">Book a consultation</Button>
        <Button href="#about" variant="outline-light" size="lg">Meet Dr. Bhalla</Button>
      </div>
    </div>

    <!-- Training strip -->
    <div class="hero-in mt-16 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-white/15 pt-6" style="--i:4">
      <span class="eyebrow text-white/45">Trained at</span>
      {trained.map((t) => <span class="display text-2xl text-white/90">{t}</span>)}
    </div>
  </div>

  <!-- Scroll hint -->
  <a
    href="#about"
    aria-label="Scroll to about"
    class="absolute bottom-8 right-8 hidden h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white/70 transition-colors hover:border-white hover:text-white md:inline-flex"
  >
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="animate-bounce-slow">
      <path d="M7 1v11M3 8l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.3" />
    </svg>
  </a>
</section>

<style>
  .hero-in {
    opacity: 0;
    transform: translateY(18px);
    animation: hero-in 0.9s var(--ease-out-soft) forwards;
    animation-delay: calc(0.15s + var(--i) * 0.12s);
  }
  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .animate-bounce-slow {
    animation: bounce-slow 2.4s ease-in-out infinite;
  }
  @keyframes bounce-slow {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-in {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .animate-bounce-slow {
      animation: none;
    }
  }
</style>
