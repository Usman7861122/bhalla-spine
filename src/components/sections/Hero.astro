---
/**
 * Home hero. The photo is shown at its natural 16:9 size, never cropped or zoomed.
 * Desktop: photo fills the width, text sits in a frosted panel over the left side.
 * Mobile: photo on top at natural size, text below.
 */
import HeroCopy from '@components/sections/HeroCopy.astro';
import { site, images } from '@data/site';
---

<section id="hero" class="relative isolate bg-porcelain">
  <!-- Phones and tablets: taller frame focused on Dr. Bhalla. Desktop: natural 16:9, no crop. -->
  <div class="relative w-full overflow-hidden pt-20 lg:pt-0">
    <img
      src={images.hero}
      alt={`${site.doctor}, orthopedic spine surgeon, at Commons Clinic in Long Beach`}
      width="1672"
      height="941"
      fetchpriority="high"
      decoding="async"
      class="hero-photo block aspect-[4/3] w-full object-cover object-[78%_center] sm:aspect-[16/10] sm:object-[70%_center] lg:aspect-auto lg:h-auto lg:object-fill"
    />
    <!-- Slight gradient on the left so the text stays readable; photo itself is untouched -->
    <div
      aria-hidden="true"
      class="absolute inset-0 hidden lg:block"
      style="background: linear-gradient(90deg, rgba(244,246,247,0.88) 0%, rgba(244,246,247,0.7) 30%, rgba(244,246,247,0.25) 46%, rgba(244,246,247,0) 58%);"
    >
    </div>
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-porcelain to-transparent"></div>

    <!-- Desktop: text directly over the photo -->
    <div class="pointer-events-none absolute inset-0 hidden lg:block">
      <div class="container-x flex h-full items-center pt-16">
        <div class="hero-in pointer-events-auto max-w-[29rem]">
          <HeroCopy />
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile and tablet: text card below the photo -->
  <div class="container-x hero-in pb-16 pt-10 lg:hidden">
    <HeroCopy />
  </div>
</section>

<style>
  .hero-in {
    opacity: 0;
    transform: translateY(18px);
    animation: hero-in 0.9s var(--ease-out-soft) 0.25s forwards;
  }
  .hero-photo {
    animation: photo-in 1.4s var(--ease-out-soft) both;
  }
  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes photo-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-in,
    .hero-photo {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
