---
/**
 * Short insurance note. PPO plans accepted, and the team verifies benefits before the visit.
 */
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import Reveal from '@components/react/Reveal';
import Icon from '@components/ui/Icon.astro';
import { site } from '@data/site';

interface Props {
  /** Use "bone" when the section above is white. */
  tone?: 'white' | 'bone';
}
const { tone = 'bone' } = Astro.props;
---

<section id="insurance" class:list={['py-16 md:py-20', tone === 'bone' && 'bg-bone/60']}>
  <Container>
    <Reveal client:visible>
      <div class="grid items-center gap-8 border border-line bg-porcelain p-8 md:grid-cols-12 md:gap-12 md:p-12">
        <div class="md:col-span-7">
          <p class="eyebrow gold-rule text-gold">Insurance</p>
          <h2 class="display mt-5 text-[clamp(1.9rem,3vw,2.6rem)] leading-tight text-ink">PPO plans accepted.</h2>
          <p class="mt-5 text-lg leading-relaxed">
            We verify your benefits before your visit. Not sure whether your plan is covered? Call us and we will check for you.
          </p>
        </div>
        <div class="flex flex-col gap-3 md:col-span-5 md:items-end">
          <Button href={site.phoneHref}>
            <Icon name="phone" class="h-4 w-4" />
            {site.phone}
          </Button>
          <Button href={site.bookingUrl} external variant="outline">Request an appointment</Button>
        </div>
      </div>
    </Reveal>
  </Container>
</section>
