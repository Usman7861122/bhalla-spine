---
/**
 * Short city focused line plus two buttons. Used in the banner instead of the full contact block.
 */
import Icon from '@components/ui/Icon.astro';
import Button from '@components/ui/Button.astro';
import { site } from '@data/site';

interface Props {
  text: string;
}
const { text } = Astro.props;
---

<div class="mt-10 max-w-2xl border-t border-white/15 pt-8">
  <p class="flex items-start gap-3 text-[0.98rem] leading-relaxed text-white/80">
    <Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-gold-light" />
    {text}
  </p>
  <div class="mt-6 flex flex-wrap gap-3">
    <Button href="/contact" variant="light">Book a consultation</Button>
    <Button href={site.phoneHref} variant="outline-light">{site.phone}</Button>
  </div>
</div>
