---
/**
 * Home page "In the news": the first feature large, the next two stacked beside it.
 * Order follows press.ts (first added shows first).
 */
import Reveal from '@components/react/Reveal';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import VideoModal from '@components/ui/VideoModal.astro';
import { site } from '@data/site';
import { press, formatPressDate } from '@data/press';

const [lead, ...rest] = press;
const side = rest.slice(0, 2);
---

{lead && (
  <section id="press" data-dark class="section-y bg-ink text-white">
    <div class="container-x">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <SectionHeading
          tone="light"
          eyebrow="In the news"
          title="Recognized by peers. Covered by the press."
          lede="Features and recognition from outlets across Southern California and beyond."
        />
        <div class="flex shrink-0 flex-wrap gap-3">
          <VideoModal facebookUrl={site.video.facebookUrl} title={site.video.title} label="Watch the video" variant="light" />
          <Button href="/press" variant="outline-light">All coverage</Button>
        </div>
      </div>

      <div class="mt-16 grid gap-5 lg:grid-cols-12">
        <!-- Lead feature -->
        <Reveal client:visible className="lg:col-span-7">
          <a href={`/press/${lead.slug}`} class="group relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-sm bg-ink-soft p-8 md:min-h-[32rem] md:p-10 lg:h-full">
            <img
              src={lead.image}
              alt=""
              loading="lazy"
              decoding="async"
              class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-out-soft)] group-hover:scale-[1.04]"
            />
            <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(15,31,46,0.1)_0%,rgba(15,31,46,0.55)_50%,rgba(15,31,46,0.96)_100%)]"></div>
            <p class="eyebrow text-gold-light">{lead.outlet} · {formatPressDate(lead.date)}</p>
            <h3 class="display mt-4 max-w-xl text-[1.9rem] leading-tight text-white md:text-[2.4rem]">{lead.title}</h3>
            <p class="mt-4 max-w-xl text-[0.95rem] leading-relaxed text-white/75">{lead.deck}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-gold-light">
              Read the story
              <Icon name="arrow" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
            </span>
          </a>
        </Reveal>

        <!-- Two more -->
        <div class="grid gap-5 lg:col-span-5">
          {side.map((p, i) => (
            <Reveal client:visible delay={0.08 + i * 0.08}>
              <a href={`/press/${p.slug}`} class="spot card-line group grid h-full overflow-hidden rounded-sm border border-line-dark bg-ink transition-colors hover:bg-ink-soft sm:grid-cols-[11rem_1fr]">
                <div class="img-zoom aspect-[16/10] overflow-hidden bg-ink-soft sm:aspect-auto sm:h-full">
                  <img src={p.image} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
                </div>
                <div class="flex flex-col p-6">
                  <p class="eyebrow text-gold-light">{p.outlet}</p>
                  <h3 class="display mt-3 text-[1.3rem] leading-snug text-white transition-colors group-hover:text-gold-light">{p.title}</h3>
                  <p class="mt-auto flex items-center justify-between pt-5 text-[0.8rem] text-white/45">
                    <span>{formatPressDate(p.date)}</span>
                    <Icon name="arrow" class="h-4 w-4 text-gold-light transition-transform duration-300 group-hover:translate-x-1" />
                  </p>
                </div>
              </a>
            </Reveal>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
