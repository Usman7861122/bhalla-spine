---
import { site, services, nav, images } from '@data/site';
const year = new Date().getFullYear();
const quickLinks = nav.filter((n) => !n.mega);
---

<footer class="bg-ink text-white">
  <!-- CTA band -->
  <div class="container-x">
    <div class="flex flex-col gap-8 border-b border-line-dark py-16 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow text-gold-light">Ready when you are</p>
        <p class="display mt-4 max-w-xl text-display-md">
          Start with a conversation, not a procedure.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href={site.bookingUrl}
          target="_blank"
          rel="noopener"
          class="hover-lift inline-flex h-12 items-center rounded-full bg-white px-7 text-sm font-medium text-ink transition-colors hover:bg-gold-light"
        >
          Book a consultation
        </a>
        <a
          href={site.phoneHref}
          class="hover-lift inline-flex h-12 items-center rounded-full border border-white/25 px-7 text-sm font-medium text-white transition-colors hover:border-white"
        >
          {site.phone}
        </a>
      </div>
    </div>
  </div>

  <!-- Columns -->
  <div class="container-x grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-4">
      <a href="/" aria-label="Amandeep Bhalla, MD, home" class="flex items-center gap-4 leading-none">
        <img src={images.commonsLogoWhite} alt="" width="92" height="25" class="h-7 w-auto" />
        <span aria-hidden="true" class="h-7 w-px bg-white/40"></span>
        <span class="text-[0.85rem] uppercase tracking-[0.08em]">
          <span class="font-semibold">Amandeep</span> <span class="font-light">Bhalla, MD</span>
        </span>
      </a>
      <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed text-white/60">
        Board-certified, fellowship-trained orthopedic spine surgeon. Medical Director, Spine Center and Vice Chair,
        Orthopaedic Surgery at MemorialCare Long Beach Medical Center.
      </p>
    </div>

    <div class="md:col-span-2">
      <p class="eyebrow text-white/40">Navigate</p>
      <ul class="mt-5 space-y-3">
        {quickLinks.map((l) => (
          <li><a href={l.href} class="footer-link link-underline">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="md:col-span-3">
      <p class="eyebrow text-white/40">Services</p>
      <ul class="mt-5 space-y-3">
        {services.map((s) => (
          <li><a href={`/services/${s.slug}`} class="footer-link link-underline">{s.title}</a></li>
        ))}
      </ul>
    </div>

    <div class="md:col-span-3">
      <p class="eyebrow text-white/40">Visit</p>
      <address class="mt-5 not-italic text-[0.95rem] leading-relaxed text-white/70">
        <a href={site.address.mapsUrl} target="_blank" rel="noopener" class="footer-link link-underline block">
          {site.address.line1}<br />{site.address.line2}
        </a>
        <a href={site.phoneHref} class="footer-link link-underline mt-4 block">{site.phone}</a>
        <span class="mt-1 block text-white/45">Fax {site.fax}</span>
        <a href={`mailto:${site.email}`} class="footer-link link-underline mt-4 block break-all">{site.email}</a>
        <span class="mt-4 block text-white/45">{site.hours}</span>
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" class="footer-link link-underline mt-4 block">LinkedIn</a>
      </address>
    </div>
  </div>

  <div class="border-t border-line-dark">
    <div class="container-x flex flex-col gap-3 py-6 text-[0.8rem] text-white/40 md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.name}. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/privacy" class="hover:text-white transition-colors">Privacy policy</a>
        <a href="/terms-conditions" class="hover:text-white transition-colors">Terms &amp; conditions</a>
        <a href="/accessibility" class="hover:text-white transition-colors">Accessibility</a>
      </div>
    </div>
  </div>
</footer>

<style>
  @reference "../styles/global.css";
  .footer-link {
    @apply text-[0.95rem] text-white/70 transition-colors hover:text-white;
  }
</style>
